# General Configuration
ANKI_DB_PATH="/Users/yourname/Library/Application Support/Anki2/User 1/collection.anki2"
LOG_LEVEL="INFO"

# Performance Tagging Parameters
MIN_REVIEW_COUNT=10
FAIL_RATE_THRESHOLD=0.3
EASY_RATE_THRESHOLD=0.1
SLOW_THRESHOLD_SECONDS=15
FAST_THRESHOLD_SECONDS=1

# Tag Naming Rules
TAG_DIFFICULT="difficult_card"
TAG_EASY="practised_card"
TAG_SLOW="slow_card"
TAG_FAST="fast_card"

# MeSH Tagging
MAX_TAGS_PER_RUN=100

# Journal outputs
JOURNAL_DIR="/Users/yourname/Desktop/"
MIN_REVIEW_COUNT=30