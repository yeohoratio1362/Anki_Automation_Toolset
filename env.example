# General Configuration
# ANKI_DB_PATH resides outside the project repo in system app data, so standard system examples are provided:
# Windows Example: "C:/Users/YOUR_USERNAME/AppData/Roaming/Anki2/User 1/collection.anki2"
# Mac Example: "/Users/YOUR_USERNAME/Library/Application Support/Anki2/User 1/collection.anki2"
ANKI_DB_PATH="C:/Users/YOUR_USERNAME/AppData/Roaming/Anki2/User 1/collection.anki2"
LOG_LEVEL="INFO"

# Performance Tagging Parameters
MIN_REVIEW_COUNT=10
FAIL_RATE_THRESHOLD=0.3
EASY_RATE_THRESHOLD=0.1
SLOW_THRESHOLD_SECONDS=15
FAST_THRESHOLD_SECONDS=1

# Tag Naming Rules
TAG_DIFFICULT="difficult_card"
TAG_EASY="practised_card"
TAG_SLOW="slow_card"
TAG_FAST="fast_card"

# Journal / PDF Output
JOURNAL_DIR="./reports"

# MeSH Matcher Settings
EMBEDDING_MODEL="nomic-embed-text"
SIMILARITY_THRESHOLD=0.90
MESH_XML_PATH="./desc2026.xml"
CACHE_PATH="./mesh_embeddings_cache.pkl"
HISTORY_FILE="./mesh_tag_history.json"
